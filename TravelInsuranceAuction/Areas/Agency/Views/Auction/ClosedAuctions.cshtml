@model List<AuctionVM>
<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">Aktivne licitacije</h2>
        </div>
    </div>

    @foreach (var group in Model.GroupBy(a => a.StartTime.Date))
    {
        <h4 class="text-secondary mt-4">@group.Key.ToString("dd.MM.yyyy")</h4>
        <div class="text-light rounded-3">
            <table class="table text-dark">
                <thead>
                    <tr>
                        <th>Destinacija</th>
                        <th>Pocetak licitacije</th>
                        <th>Kraj licitacije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var obj in group)
                    {
                        <tr>
                            <td>@obj.Destination</td>
                            <td>@obj.StartTime.ToString("hh:mm tt")</td>
                            <td>@obj.EndTime.ToString("hh:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>