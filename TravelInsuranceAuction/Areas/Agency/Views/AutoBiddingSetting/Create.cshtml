@model AutoBiddingSetting


<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ms-0 py-4">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="py-2 text-white">Kreiraj pravila aukcije</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <section>
                    <form method="post">
                        <div class="border p-3 mt-4">
                            <input asp-for="AgencyId" type="hidden" />
                            <div class="mb-3 row p-1">
                                <label asp-for="DefaultStartPrice" class="p-0"></label>
                                <input asp-for="DefaultStartPrice" class="form-control" />
                                <span asp-validation-for="DefaultStartPrice" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="DefaultMinPrice" class="p-0"></label>
                                <input asp-for="DefaultMinPrice" class="form-control" />
                                <span asp-validation-for="DefaultMinPrice" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="PriceDecrease" class="p-0"></label>
                                <input asp-for="PriceDecrease" class="form-control" />
                                <span asp-validation-for="PriceDecrease" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="LoweringTime" class="p-0"></label>
                                <input asp-for="LoweringTime" class="form-control" />
                                <span asp-validation-for="LoweringTime" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="SpecialConditions" class="p-0"></label>
                                <input asp-for="SpecialConditions" class="form-control" />
                                <span asp-validation-for="SpecialConditions" class="text-danger"></span>
                            </div>
                            <div class="row">
                                <div class="col-6 ">
                                    <button type="submit" class="btn btn-primary form-control">
                                        Sacuvaj
                                    </button>
                                </div>
                                <div class="col-6 ">
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary border form-control">
                                        Vrati se na pocetnu stranu
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </section>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}