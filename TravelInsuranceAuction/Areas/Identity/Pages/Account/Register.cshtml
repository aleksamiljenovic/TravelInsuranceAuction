@page
@model RegisterModel

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ms-0 py-4">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="py-2 text-white">Registruj se</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pt-3">
            <div class="col-md-12">
                <form id="registerForm" class="row" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Ime" />
                        <label asp-for="Input.FirstName" class="ms-2 text-muted">Ime</label>
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.LastName" class="form-control" placeholder="Prezime" />
                        <label asp-for="Input.LastName" class="ms-2 text-muted">Prezime</label>
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-12">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="ms-2 text-muted">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Lozinka" />
                        <label asp-for="Input.Password" class="ms-2 text-muted">Lozinka</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="lozinka" />
                        <label asp-for="Input.ConfirmPassword" class="ms-2 text-muted">Potvrdi lozinku</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.City" class="form-control" placeholder="Grad" />
                        <label asp-for="Input.City" class="ms-2 text-muted">Grad</label>
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.StreetAddress" class="form-control" placeholder="Adresa" />
                        <label asp-for="Input.StreetAddress" class="ms-2 text-muted">Adresa</label>
                        <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Telefon" />
                        <label asp-for="Input.PhoneNumber" class="ms-2 text-muted">Telefon</label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>



                    <div class="form-floating mb-3 col-md-6">
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select">
                            <option disabled selected>--Select Role--</option>
                        </select>
                    </div>

                    <div class="form-floating mb-3 col-md-12">
                        <select asp-for="Input.AgencyId" style="display:none" asp-items="@Model.Input.AgencyList" class="form-select">
                            <option disabled selected>--Select Agency--</option>
                        </select>
                    </div>
                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Registruj se</button>
                </form>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function(){
            $('#Input_Role').change(function(){
                var selection = $('#Input_Role Option:Selected').text();
                if(selection=='Agency'){
                    $('#Input_AgencyId').show();
                }else{
                    $('#Input_AgencyId').hide();
                }
            })
        })
    </script>
}