@model List<InsuranceRequest>

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">Završene licitacije</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="InsuranceRequest" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Dodaj novu licitaciju
            </a>
        </div>
    </div>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Nema završenih licitacija
        </div>
    }
    else
    {
        @foreach (var group in Model.GroupBy(a => a.createdAt.Date))
        {
            <h4 class="text-secondary mt-4">@group.Key.ToString("dd.MM.yyyy")</h4>
            <div class="text-light rounded-3">
                <table class="table text-dark">
                    <thead>
                        <tr>
                            <th>Destinacija</th>
                            <th>Datum polazka</th>
                            <th>Datum povratka</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obj in group)
                        {
                            <tr>
                                <td>@obj.Destination</td>
                                <td>@obj.StartDate</td>
                                <td>@obj.EndDate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }


</div>