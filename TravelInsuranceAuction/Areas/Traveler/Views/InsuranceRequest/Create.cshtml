@model InsuranceRequest




<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ms-0 py-4">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="py-2 text-white">Dodaj licitaciju</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <section>
                    <form method="post">
                        <div class="border p-3 mt-4">
                            <div class="mb-3 row p-1">
                                <label asp-for="Destination" class="p-0"></label>
                                <input asp-for="Destination" class="form-control" />
                                <span asp-validation-for="Destination" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="StartDate" class="p-0"></label>
                                <input asp-for="StartDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="EndDate" class="p-0"></label>
                                <input asp-for="EndDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                            <div class="mb-3 row p-1">
                                <label asp-for="NumberOfTravelers" class="p-0"></label>
                                <input asp-for="NumberOfTravelers" class="form-control" />
                                <span asp-validation-for="NumberOfTravelers" class="text-danger"></span>
                            </div>
                            <div class="row">
                                <div class="col-6 ">
                                    <button type="submit" class="btn btn-primary form-control">
                                        Kreiraj licitaciju
                                    </button>
                                </div>
                                <div class="col-6 ">
                                    <a asp-controller="InsuranceRequest" asp-action="Index" class="btn btn-outline-secondary border form-control">
                                        Vrati se na tvoje licitacije
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </section>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}