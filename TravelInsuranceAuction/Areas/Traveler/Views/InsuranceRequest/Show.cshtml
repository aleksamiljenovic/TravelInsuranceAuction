<script>

    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/priceHub")
        .build();

    connection.start().then(function () {
        connection.invoke("JoinAuctionGroup", @Model.AuctionId);
    });

    connection.on("PriceUpdated", function (offerId, newPrice) {

        var element = document.getElementById("price-" + offerId);

        if (element)
            element.innerText = newPrice;

    });

    connection.on("AuctionFinished", function (offerId) {

        alert("Aukcija je završena!");

        location.reload();

    });

</script>