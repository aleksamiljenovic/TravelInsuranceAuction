@model AuctionOffersVM

<div class="container">
    <div class="row align-items-center pt-4 pb-3 mb-4 border-bottom">
        <div class="col-md-8">
            <span class="badge text-bg-primary mb-2">Aktivna licitacija</span>
            <h1 class="fw-bold mb-1">@Model.Destination</h1>
            <p class="text-muted mb-1">
                <i class="bi bi-clock"></i>
                Trajanje: @(Model.AuctionStartTime?.ToString("hh:mm tt") ?? "N/A") — @(Model.AuctionEndTime?.ToString("hh:mm tt") ?? "N/A")
            </p>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar"></i>
                Kraj aukcije: @Model.AuctionEndTime
            </p>
        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="bg-light rounded-3 p-3 d-inline-block text-center mb-3">
                <p class="text-muted small mb-1">Preostalo vreme</p>
                <h3 class="fw-bold text-primary mb-0"><span id="timer"></span></h3>
            </div>
            <br />
            <form asp-action="CancelAuction" method="post">
                <input type="hidden" name="auctionId" value="@Model.AuctionId" />
                <button type="submit" class="btn btn-outline-danger"
                        onclick="return confirm('Da li ste sigurni da želite da poništite aukciju?')">
                    <i class="bi bi-x-circle"></i> Poništi aukciju
                </button>
            </form>
        </div>
    </div>
    <h3 class="text-primary">Ponude:</h3>
    <div class="text-light borde rounded-3">
        <table id="tblData" class="table text-dark">
            <thead>
                <tr>
                    <th>Osiguravajuca kuca</th>
                    <th>Pocetna cena</th>
                    <th>Trenutna cena</th>
                    <th>Pokrice</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model.Offers.OrderBy(o => o.CurrentPrice))
                {

                    <tr>
                        <td>@obj.AgencyName</td>
                        <td>@obj.InitialPrice</td>
                        <td><span id="price-@obj.Id">@obj.CurrentPrice €</span></td>
                        <td>@obj.Conditions</td>
                        <td>
                            <form asp-action="SelectOffer" method="post">
                                <input type="hidden" name="offerId" value="@obj.Id" />

                                <button type="submit" class="btn btn-success" onclick="return confirm('Da li ste sigurni da želite da izaberete ovu polisu?')">
                                    Izaberi ponudu
                                </button>
                            </form>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts{
    <script>
        var endTime = new Date("@Model.AuctionEndTime?.ToString("yyyy-MM-ddTHH:mm:ss")").getTime();

        var timer = setInterval(function() {
            var now = new Date().getTime();
            var distance = endTime - now;

            if (distance < 0) {
                clearInterval(timer);
                document.getElementById("timer").innerHTML = "Aukcija završena";
                return;
            }

            var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            var seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("timer").innerHTML =
                hours + "h " + minutes + "m " + seconds + "s";
        }, 1000);
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/priceHub")
            .build();

        connection.start().then(function () {
            connection.invoke("JoinAuctionGroup", @Model.AuctionId);
        });

        connection.on("PriceUpdated", function (offerId, newPrice) {
            const span = document.getElementById("price-" + offerId);
            if (span) {
                span.textContent = newPrice.toFixed(2) + " €";
            }
            sortTableByPrice();
        });

        // connection.on("AuctionFinished", function () {
        //     alert("Aukcija je završena!");
        //     location.reload();
        // });

        function sortTableByPrice() {
            const tbody = document.querySelector("tbody");
            const rows = Array.from(tbody.querySelectorAll("tr"));

            rows.sort((a, b) => {
                const priceA = parseFloat(a.querySelector("span[id^='price-']").textContent);
                const priceB = parseFloat(b.querySelector("span[id^='price-']").textContent);
                return priceA - priceB;
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
    
}
