@model AuctionOffersVM

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            
            <h1 class="text-primary">@Model.Destination</h1>
            <h3>
                Trajanje licitacije: 
                @(Model.AuctionStartTime?.ToString("hh:mm tt") ?? "N/A") - 
                @(Model.AuctionEndTime?.ToString("hh:mm tt") ?? "N/A")
            </h3>
            <h3 class="text-primary">Ponude:</h3>
            <p>Kraj aukcije: @Model.AuctionEndTime</p>

            <p>Preostalo vreme: <span id="timer"></span></p>
        </div>
    </div>

    <div class="text-light borde rounded-3">
        <table class="table text-dark">
            <thead>
                <tr>
                    <th>Osiguravajuca kuca</th>
                    <th>Pocetna cena</th>
                    <th>Trenutna cena</th>
                    <th>Pokrice</th>

                </tr>
            </thead>
            @foreach (var obj in Model.Offers)
            {
                <tbody>
                    <tr>
                        <td>@obj.AgencyName</td>
                        <td>@obj.InitialPrice</td>
                        <td>@obj.CurrentPrice</td>
                        <td>@obj.Conditions</td>

                    </tr>
                </tbody>
            }
        </table>
    </div>

</div>

<script>
     var endTime = new Date("@Model.AuctionEndTime?.ToString("yyyy-MM-ddTHH:mm:ss")").getTime();

    var timer = setInterval(function() {

        var now = new Date().getTime();
        var distance = endTime - now;

        if (distance < 0) {
            clearInterval(timer);
            document.getElementById("timer").innerHTML = "Aukcija završena";
            return;
        }

        var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((distance % (1000 * 60)) / 1000);

        document.getElementById("timer").innerHTML =
            hours + "h " + minutes + "m " + seconds + "s";

    }, 1000);
</script>