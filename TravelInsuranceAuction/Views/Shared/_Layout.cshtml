<!DOCTYPE html>
<html lang="en">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelInsuranceAuction</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TravelInsuranceAuction.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">TravelInsuranceAuction</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        
                        
                        @if (User.IsInRole(SD.Role_Traveler))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Traveler" asp-controller="Home" asp-action="Index">Početna</a>
                            </li>
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Aukcija
                                </a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item" asp-area="Traveler" asp-controller="InsuranceRequest" asp-action="Index">Akrivne licitacije</a>
                                    <a class="dropdown-item" asp-area="Traveler" asp-controller="InsuranceRequest" asp-action="ClosedAuctions">Zavrsene licitacije</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="Traveler" asp-controller="InsuranceRequest" asp-action="Create">Kreiraj licitacije <i class="bi bi-plus-circle"></i></a>
                                </div>
                            </li>

                            
                        }
                        @if (User.IsInRole(SD.Role_Agency))
                        {
                            @* <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Agency" asp-controller="Home" asp-action="Index">Početna</a>
                            </li> *@

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Agency" asp-controller="Auction" asp-action="Statistics">Statistika</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Aukcija
                                </a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item" asp-area="Agency" asp-controller="Auction" asp-action="Index">Aktivne licitacije</a>
                                    <a class="dropdown-item" asp-area="Agency" asp-controller="Auction" asp-action="ClosedAuctions">Istorija licitacija</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="Agency" asp-controller="AutoBiddingSetting" asp-action="Index">Pravila licitacije</a>
                                </div>
                            </li>
                        }
                        @if (User.IsInRole(SD.Role_Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Admin" asp-controller="Admin" asp-action="FinancialOverview">Finansijski pregled</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Admin" asp-controller="Admin" asp-action="Verification">Verifikacija</a>
                            </li>
                        }

                    </ul>
                    <partial name="_LoginPartial"/>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3 mb-5">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-primary text-muted">
        <div class="text-center text-light">
            &copy; 2026 - TravelInsuranceAuction - 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.IsInRole(SD.Role_Agency))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        <script>
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/priceHub")
                .build();

            connection.start().then(function () {
                connection.invoke("JoinAgencyGroup");
            });

            connection.on("AuctionStarted", function (auctionId, destination) {
                const container = document.createElement("div");
                container.innerHTML = `
                    <div id="notif-${auctionId}"
                         style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px;">
                        <div class="alert alert-info alert-dismissible shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-hammer fs-5"></i>
                            <div>
                                <strong>Nova aukcija!</strong><br>
                                <small>${destination} — aukcija je upravo počela.</small>
                            </div>
                            <button type="button" class="btn-close ms-auto"
                                    onclick="this.closest('#notif-${auctionId}').remove()">
                            </button>
                        </div>
                    </div>`;
                document.body.appendChild(container);

                setTimeout(() => {
                    const el = document.getElementById("notif-" + auctionId);
                    if (el) el.closest("div").remove();
                }, 8000);
            });
        </script>
    }
</body>
</html>
